# Ledgerly: settings for `docker compose up`. Copy this file to .env (git-ignored) and leave it as is to try the app.
#
# These are DEMO values: fine on your own computer, never for a real server.
# For a real deployment: set strong values below, set ALLOW_DEMO_SECRETS=false and SEED_DEMO_DATA=false.
# (The API refuses to start in production while a "demo-only-" value is in use and ALLOW_DEMO_SECRETS is not true.)

# Database. Use only letters, digits, - . _ in the password (it is placed inside a connection URL).
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=demo-only-db-password
POSTGRES_DB=ledgerly

# Signs login tokens. 32+ characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=demo-only-jwt-secret-change-me-0123456789

# Port you open in the browser: http://localhost:8080
WEB_PORT=8080

# true = load 22 demo users and 50 demo transactions the first time the database is empty.
SEED_DEMO_DATA=true
# true = allow the demo-only values above while running in production mode (needed for this demo).
ALLOW_DEMO_SECRETS=true

# Optional
# APP_TIMEZONE=Asia/Kolkata
# LOG_LEVEL=info
