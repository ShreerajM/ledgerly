              "const d = pm.response.json();",
              "pm.test(\"Token issued\", () => pm.expect(d.token).to.be.a(\"string\").and.not.empty);",
              "pm.test(\"New account is a regular user\", () => pm.expect(d.user.role).to.eql(\"user\"));",
              "pm.test(\"Password hash is never returned\", () => pm.expect(JSON.stringify(d)).to.not.include(\"passwordHash\"));",
              "pm.environment.set(\"newUserToken\", d.token);"
            ]
