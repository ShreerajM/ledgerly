    {
      "name": "17 - FAILURE F1 reproduce: login sent as text/plain (expect 400)",
      "description": "Introduced fault: body type is Text, so Content-Type is text/plain and the API never parses the body. Expect 400 VALIDATION_ERROR saying email and password are missing even though they are in the body.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "const f = pm.response.json().error.details.fieldErrors;",
              "pm.test(\"API reports both fields missing (body was not parsed)\", () => {",
              "  pm.expect(f).to.have.property(\"email\");",
              "  pm.expect(f).to.have.property(\"password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
