    {
      "name": "19 - FAILURE F2 reproduce: token with invalid signature (expect 401)",
      "description": "Introduced fault: a token whose signature does not match the API JWT_SECRET (what a rotated or mismatched secret produces). The pre-request script alters the first character of the signature of the valid admin token. Run request 02 first so adminToken exists.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const parts = (pm.environment.get(\"adminToken\") || \"\").split(\".\");",
              "if (parts.length === 3) {",
              "  parts[2] = (parts[2][0] === \"A\" ? \"B\" : \"A\") + parts[2].slice(1);",
              "}",
              "pm.collectionVariables.set(\"invalidSignatureToken\", parts.join(\".\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Message says session expired although the token has not expired (misleading)\", () => pm.expect(pm.response.json().error.message).to.include(\"expired\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/dashboard",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{invalidSignatureToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
