# true  = run against the in-memory mock API (no backend needed)
# false = call the real REST API (proxied to VITE_PROXY_TARGET in dev)
VITE_USE_MOCK=false
# Base path of the REST API. Nginx forwards /api to the backend in production.
VITE_API_BASE_URL=/api
# Dev-server proxy target for /api
VITE_PROXY_TARGET=http://localhost:4000
