// Prisma schema: the single source of truth for the data model.
// Change it, then run `npm run db:migrate:dev -- --name <what_changed>` to create a SQL migration.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // Node runs TypeScript directly and needs explicit ".ts" in relative imports.
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user

  @@map("user_role")
}

enum TransactionStatus {
  success
  pending
  failed

  @@map("transaction_status")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  /// Always stored lowercase by the API; a CHECK constraint in the migration enforces it in the database too.
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(user)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions Transaction[]

  // Users page filters: role and active/inactive.
  @@index([isActive, role])
  @@map("users")
}

model Transaction {
  id        Int               @id @default(autoincrement())
  /// TXN-0001 style reference. A generated column in the migration derives it from id, so it never drifts.
  reference String            @unique @default(dbgenerated())
  userId    Int               @map("user_id")
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(pending)
  note      String            @default("")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Indexes chosen for the queries the API actually runs:
  //   per-user lists and dashboards         -> (user_id, created_at DESC)
  //   status filters and failed-last-7-days -> (status, created_at DESC)
  //   admin "all transactions" newest first -> (created_at DESC)
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("transactions")
}
