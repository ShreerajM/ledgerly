# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Every value is validated at startup (src/config/env.ts); a bad value stops the API with a clear message.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string. Matches docker-compose.yml and `npm run db:dev`.
DATABASE_URL=postgres://ledgerly:change-me@localhost:5432/ledgerly

# Connection pool (see "Troubleshooting" in the README before changing these)
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=false

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# 1 when running behind Nginx, 0 otherwise
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true
APP_TIMEZONE=Asia/Kolkata

# In production mode the API refuses values that contain "demo-only-" (the demo stack in ../compose.yaml uses them).
# Set to true only for a local demo.
ALLOW_DEMO_SECRETS=false
